# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/pinnacle_ai

# Session Secret (change this in production)
SESSION_SECRET=pinnacle-ai-super-secret-key-change-in-production

# Server Configuration
PORT=7854
NODE_ENV=development

# Daily member update + Teams report settings
DAILY_REPORT_TIMEZONE=Asia/Kolkata
DAILY_REPORT_SEND_TIME=22:00
TEAMS_WEBHOOK_URL=

# Default Admin Configuration (used on first startup if no users exist)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin
DEFAULT_ADMIN_EMAIL=admin@sierraedge.ai
